# Ajánlatkérő űrlap e-mail küldése. Üresen hagyva az űrlap telefonos/e-mailes tartalékot mutat.
# Csak az űrlap ajánlatkérései mennek ide; a weboldalon kiírt kapcsolati cím (lib/site.ts) marad info@.
QUOTE_TO_EMAIL=ajanlat@geoscan3d.hu
QUOTE_FROM_EMAIL="Ajánlatkérés <ajanlat@geoscan3d.hu>"

# Forpsi SMTP (elsődleges). A jelszó az ajanlat@geoscan3d.hu postafiók jelszava.
SMTP_HOST=smtp.forpsi.com
SMTP_PORT=587
SMTP_USER=ajanlat@geoscan3d.hu
SMTP_PASS=

# Resend (tartalék, csak ha nincs SMTP)
RESEND_API_KEY=

# Csak ha a site.domain még helykitöltő (pl. Vercel preview URL)
NEXT_PUBLIC_SITE_URL=
